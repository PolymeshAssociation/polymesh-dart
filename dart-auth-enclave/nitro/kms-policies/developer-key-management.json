{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateDartEnclaveTestKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:ListAliases",
        "kms:ListKeys",
        "kms:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageDartEnclaveTestKeyPolicy",
      "Effect": "Allow",
      "Action": [
        "kms:PutKeyPolicy",
        "kms:GetKeyPolicy",
        "kms:DescribeKey",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion"
      ],
      "Resource": "arn:aws:kms:<REGION>:<ACCOUNT_ID>:key/*"
    }
  ]
}
